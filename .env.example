# 服务器部署专用：复制为根目录 .env，chmod 600；开发仍用 retrue-server/.env。
# 必填敏感值故意留空；不要提交填写后的文件。
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=retrue.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://retrue.example.com
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_STATIC_URL=/retrue/static/

POSTGRES_DB=retrue
POSTGRES_USER=retrue
POSTGRES_PASSWORD=
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_SSLMODE=prefer

WEB_CONCURRENCY=2
LOG_TO_FILE=false
APP_LOG_LEVEL=INFO
GUNICORN_LOG_LEVEL=info

# 每次发布使用唯一版本号；静态文件随版本保留，media 跨版本持久化。
RETRUE_IMAGE_TAG=local
RETRUE_STATIC_DIR=./var/static
RETRUE_MEDIA_DIR=./var/media

# 当前 YAML 已启用，聊天仅使用首个 DeepSeek（故障转移开关为 false）。
# QWEN_API_KEY 用于知识库 embedding；AI_PROVIDER=mock 不会覆盖已启用的 YAML。
AI_CONFIG_FILE=/app/ai_config.yaml
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# AI_API_KEY=
# AI_EMBEDDING_API_KEY=
