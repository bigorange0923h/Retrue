DJANGO_SECRET_KEY=replace-with-a-strong-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_DB=retrue
POSTGRES_USER=retrue
POSTGRES_PASSWORD=replace-with-the-same-value-as-RETRUE_POSTGRES_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# ============================================================
# AI 服务商配置（配置化）
# AI_PROVIDER 可选值：mock（默认，本地无真实模型）/
#                     deepseek（DeepSeek，OpenAI 兼容协议）
# AI_API_KEY 为敏感信息，仅存于服务端 .env，不得提交仓库。
# DeepSeek 默认模型为 deepseek-chat，可在 AI_MODEL 覆盖。
# ============================================================
AI_PROVIDER=mock
AI_API_KEY=replace-with-your-ai-provider-api-key
AI_MODEL=deepseek-chat
AI_BASE_URL=
AI_TIMEOUT=60
AI_MAX_TOKENS=2000
