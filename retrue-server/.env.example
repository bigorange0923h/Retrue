DJANGO_SECRET_KEY=replace-with-a-strong-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_DB=retrue
POSTGRES_USER=retrue
POSTGRES_PASSWORD=replace-with-the-same-value-as-RETRUE_POSTGRES_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# ============================================================
# AI 服务商配置（配置化）
# AI_PROVIDER 可选值：mock（默认，本地无真实模型）/
#                     deepseek（DeepSeek / Qwen 等 OpenAI 兼容协议）
# AI_API_KEY 为敏感信息，仅存于服务端 .env，不得提交仓库。
# DeepSeek 默认模型为 deepseek-chat，可在 AI_MODEL 覆盖。
#
# Base URL（OpenAI 兼容协议）：
# - DeepSeek:   https://api.deepseek.com
# - 阿里云百炼 Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
# 配置单个服务商时用 AI_BASE_URL；多模型故障转移时在每个条目内用 base_url。
#
# 多模型故障转移（可选）：
# 设置 AI_FALLBACK_PROVIDERS 为 JSON 数组，将按顺序使用多个 provider，
# 单一模型网络异常时自动切换下一个。示例（DeepSeek 主用 + Qwen 兜底）：
#   AI_FALLBACK_PROVIDERS=[{"provider":"deepseek","model":"deepseek-chat","base_url":"https://api.deepseek.com"},{"provider":"deepseek","model":"qwen-max","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1"},{"provider":"mock"}]
# 若未设置该变量，则回退到单 provider（AI_PROVIDER）。
# ============================================================
AI_PROVIDER=mock
AI_API_KEY=replace-with-your-ai-provider-api-key
AI_MODEL=deepseek-chat
AI_BASE_URL=
AI_TIMEOUT=60
AI_MAX_TOKENS=2000
AI_FALLBACK_PROVIDERS=
