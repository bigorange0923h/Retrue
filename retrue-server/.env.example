DJANGO_SECRET_KEY=replace-with-a-strong-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_DB=retrue
POSTGRES_USER=retrue
POSTGRES_PASSWORD=replace-with-the-same-value-as-RETRUE_POSTGRES_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# ============================================================
# AI 服务商配置（配置化）
# 约定：.env 只放敏感密钥与单服务商标量；多模型配置放 ai_config.yaml。
#
# 单服务商（简单场景）：
#   AI_PROVIDER 可选值：mock（默认，本地无真实模型）/ deepseek（DeepSeek 或 Qwen 等 OpenAI 兼容协议）
#   AI_API_KEY 为敏感信息，仅存于服务端 .env，不得提交仓库。
#   DeepSeek 默认模型为 deepseek-chat，可在 AI_MODEL 覆盖。
#
# 多模型故障转移（推荐用 yaml，见 ai_config.yaml）：
#   ai_config.yaml 已默认启用，聊天模型在 chat.models 中按顺序定义。
#   单次失败立即切换；连续失败达到阈值时熔断。也可用 AI_FALLBACK_PROVIDERS（JSON 数组）作为兼容备选。
#   密钥通过 api_key_env 引用下方独立变量。
# ============================================================
AI_PROVIDER=mock
AI_API_KEY=replace-with-your-ai-provider-api-key
AI_MODEL=deepseek-chat
AI_BASE_URL=
AI_TIMEOUT=60
AI_MAX_TOKENS=2000
AI_FALLBACK_PROVIDERS=

# 各服务商独立 API Key（供 ai_config.yaml / AI_FALLBACK_PROVIDERS 的 api_key_env 引用）
# DEEPSEEK_API_KEY=replace-with-deepseek-key
# QWEN_API_KEY=replace-with-qwen-key

# 多模型 yaml 配置路径（可选，默认 retrue-server/ai_config.yaml）
# AI_CONFIG_FILE=

# ============================================================
# Embedding（客户私有知识库 RAG，使用 Qwen text-embedding-v3）
# 说明：embedding 配置优先读 ai_config.yaml 的 embeddings 段；
# 也可用下方单 provider 变量直接覆盖。AI_EMBEDDING_API_KEY 缺省时回退到 AI_API_KEY。
# ============================================================
# AI_EMBEDDING_PROVIDER=qwen
# AI_EMBEDDING_MODEL=text-embedding-v3
# AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_EMBEDDING_API_KEY=replace-with-qwen-key
